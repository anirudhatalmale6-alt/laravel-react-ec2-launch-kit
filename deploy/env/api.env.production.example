# /var/www/app/shared/api/.env
#
# Lives OUTSIDE the release directories and is symlinked into each one, so a
# deploy never touches it and a rollback never reverts it.
#
# Two rules that cost whole evenings when broken:
#   1. No space around any `=`. Dotenv rejects the entire file for one, and
#      the app then boots with no configuration at all, not with one bad
#      value. deploy.sh refuses to deploy if it finds one.
#   2. Quote any value containing a `#` or a space, or everything after it
#      is read as a comment.
#
# After editing this file: php artisan config:clear && php artisan config:cache
# A cached config keeps serving the OLD values, which is the usual reason a
# "corrected" Stripe secret still fails.

APP_NAME="Your SaaS"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show   (64 chars, base64:)
APP_DEBUG=false                # never true in production: it prints the .env to the browser on a 500
APP_URL=https://DOMAIN
ASSET_URL=https://DOMAIN

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- database ---------------------------------------------------------------
# RDS is not in use yet, so this is the MySQL on the instance itself. Moving
# to RDS later changes only these five lines.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=

# --- sessions, cache, queue -------------------------------------------------
# Database-backed so nothing is lost on a php-fpm reload and no Redis is
# needed on a single box. If a second instance is ever added, these have to
# move to Redis or ElastiCache first, or users will be logged out at random
# as the load balancer moves them between boxes.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# The SPA and the API are on the SAME origin in this setup, so no CORS and no
# cross-site cookie problems. If the front end ever moves to its own
# hostname, both of the next two have to list it or every authenticated
# request starts returning 419.
SANCTUM_STATEFUL_DOMAINS=DOMAIN
SESSION_DOMAIN=DOMAIN

# --- stripe (LIVE) ----------------------------------------------------------
# All three change when you flip the switch, and the third one is the one
# everybody forgets. The signing secret is per ENDPOINT per MODE: the value
# shown for the test endpoint will not verify a live event.
STRIPE_KEY=pk_live_
STRIPE_SECRET=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_

# Cashier only, if the app uses it. Price IDs are also per-mode: a
# price_... created in test mode does not exist in live mode.
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en_US
CASHIER_LOGGER=stack

# --- mail -------------------------------------------------------------------
# Port 25 outbound is blocked on EC2 by default and the block is not
# removable on demand, so sending mail directly from the box will fail
# silently. Use a provider over 587.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"
