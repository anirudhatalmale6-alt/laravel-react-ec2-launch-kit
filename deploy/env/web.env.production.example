# web/.env.production  (Vite)
#
# Everything here is BAKED INTO THE BUNDLE at build time and is readable by
# anyone who opens devtools. Only the publishable key belongs in it. A secret
# key placed here is published the moment the build goes out, and has to be
# rotated, not just removed.
#
# Changing a value here requires a REBUILD. Editing it on the server and
# reloading nginx changes nothing, because the old value is already compiled
# into the hashed JS.

# Same origin as the SPA, so a relative base needs no CORS setup at all.
VITE_API_BASE_URL=/api

# Must be the pk_live_ that matches the sk_live_ in the API .env. A mismatch
# here is invisible until a customer pays: the browser creates the intent in
# one mode and the server looks for it in the other.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_

VITE_APP_ENV=production
